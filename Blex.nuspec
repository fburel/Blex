<?xml version="1.0"?>
<package >
  <metadata>
    <id>Blex.f10-solutions</id>
    <version>1.3.1</version>
    <title>Blex</title>
    <authors>f10-solutions</authors>
    <owners>f10-solutions</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Blex is a cross platform BLE library for Xamarin.</description>
    <summary>Blex brings the native Bluetooth Low Energy (a.k.a Bluetooth 4.0) capacities of Android and iOS into the Xamarin cross platform world.</summary>
    <releaseNotes>iOS: Disconnect now really disconnects the peripheral (CancelPeripheralConnection); it used to report success while the connection stayed open. It completes when iOS confirms the disconnection, or after 5 seconds.</releaseNotes>
    <copyright>Copyright 2020</copyright>
    <tags>bluetooth low energy ble iot</tags>
    <projectUrl>https://github.com/fburel/Blex</projectUrl>
    <repository type="git" url="https://github.com/fburel/Blex.git" branch="master" commit="460a11d62e1558ae77f03789b42e1e27a694682e" />
    <license type="expression">MIT</license>
    <dependencies>
        <group targetFramework="net8.0">
            <!--x dependencies go here-->
        </group>
        <group targetFramework="net10.0">
            <!--x dependencies go here-->
        </group>
        <group targetFramework="net10.0-ios26.0">
            <!--iOS dependencies go here-->
        </group>
        <group targetFramework="net10.0-android36.0">
            <!--Android dependencies go here-->
        </group>
    </dependencies>

  </metadata>
  <files>
    <!-- cross platform assemblies -->
    <file src="Blex/bin/Release/net8.0/Blex.dll" target="lib/net8.0" />
    <file src="Blex/bin/Release/net10.0/Blex.dll" target="lib/net10.0" />

    <!-- iOS reference assemblies -->
    <file src="Blex.Touch/bin/Release/net10.0-ios/Blex.dll" target="lib/net10.0-ios26.0" />
    <file src="Blex.Touch/bin/Release/net10.0-ios/Blex.Touch.dll" target="lib/net10.0-ios26.0" />

    <!-- Android reference assemblies -->
    <file src="Blex.Droid/bin/Release/net10.0-android/Blex.dll" target="lib/net10.0-android36.0" />
    <file src="Blex.Droid/bin/Release/net10.0-android/Blex.Droid.dll" target="lib/net10.0-android36.0" />
  </files>
</package>
